{
  "name": "careervp-subscription-tests",
  "version": "1.0.0",
  "private": true,
  "description": "CareerVP Subscription & Stripe Integration Test Suite",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --selectProjects unit",
    "test:integration": "jest --config jest.config.ts --selectProjects integration",
    "test:e2e": "jest --config jest.config.ts --selectProjects e2e",
    "test:regression": "jest --config jest.config.ts --selectProjects regression",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:critical": "jest --config jest.config.ts --selectProjects critical",
    "test:perf": "PERF_TEST=true jest --config jest.config.ts --selectProjects perf",
    "test:ops": "OPS_TEST=true jest --config jest.config.ts --selectProjects ops",
    "test:security": "jest --config jest.config.ts --selectProjects security",
    "test:all": "jest --config jest.config.ts",
    "tokens:transform": "ts-node scripts/transform-tokens.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.500.0",
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/client-ssm": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "@figma/code-connect": "^1.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "ajv": "^8.20.0",
    "jest": "^29.7.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.4",
    "stripe": "^14.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "amazon-cognito-identity-js": "^6.3.16",
    "axios": "^1.15.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.4",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "turndown": "^7.2.4",
    "zustand": "^5.0.12"
  }
}
