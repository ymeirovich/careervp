.gitignore

# Next.js (src/frontend app)
src/frontend/.next/
src/frontend/next-env.d.ts

# Figma Tokens Plugin export (source of truth is tokens.css)
src/frontend/figma-tokens.json
src/frontend/tests/e2e/.auth/

# Test coverage artifacts (generated, not source)
.coverage
coverage.json
htmlcov/

# STATE page — a rendered view of proofs, never a source. Regenerate, do not commit.
state/

# Playwright run artifacts — regenerated every run, never source.
src/frontend/playwright-report/
src/frontend/test-results/

# TypeScript incremental build artifact — `npm run typecheck` rewrites it on
# every run, so a committed copy makes `git_dirty: false` unreachable after the
# mandatory checks (sweep-00 finding #2, closed by handoff 03 Step 3).
src/frontend/dist/

# setuptools build metadata for the editable `service-cdk` install
# (src/backend/pyproject.toml: service-cdk = { path = "../../infra", editable = true }).
# `uv sync` regenerates these, so tracking them made every CI deploy see a dirty
# tree and stamp DeployedGitSha `-dirty`. Build output is never committed.
*.egg-info/
