#### Spec 2: `company_research_fvs_spec.yaml`

```yaml
spec_version: "1.0"
date_created: "2026-02-14"
purpose: "FVS validation requirements for Company Research"
status: "READY_FOR_IMPLEMENTATION"

validation_requirements:
  grammar_score:
    minimum: 9.0
    maximum: 10.0
  anti_ai_score:
    minimum: 9.0
    maximum: 10.0
  brand_mentions:
    max_count: 3
  ai_buzzwords:
    blocked:
      - "synergy"
      - "leverage"
      - "paradigm shift"
      - "cutting-edge"
      - "best-in-class"

content_validation:
  required_sections:
    - "company_name"
    - "mission"
    - "values"
    - "culture"
    - "products"
  length_limits:
    total_max_words: 2000
    per_section_max_words: 500

error_codes:
  FVS_COMPANY_001:
    message: "Grammar score below threshold"
    action: "Regenerate with improved grammar"
  FVS_COMPANY_002:
    message: "AI detection patterns found"
    action: "Rewrite with natural language"
  FVS_COMPANY_003:
    message: "Missing required section"
    action: "Complete all required sections"
```

#### Spec 3: `company_research_payload_spec.yaml`

```yaml
spec_version: "1.0"
date_created: "2026-02-14"
purpose: "Payload specifications for Company Research testing"
status: "READY_FOR_IMPLEMENTATION"

payloads:
  live_test:
    file: "docs/refactor/payloads/phase8_company_research_live_test.json"
    schema:
      type: "object"
      required:
        - "company_name"
        - "job_id"
        - "options"
      properties:
        company_name:
          type: "string"
        job_id:
          type: "string"
        options:
          type: "object"
          properties:
            extract_mission:
              type: "boolean"
              default: true
            extract_values:
              type: "boolean"
              default: true
            extract_recent_news:
              type: "boolean"
              default: true
            extract_products:
              type: "boolean"
              default: true
            cache_result:
              type: "boolean"
              default: true
            ttl_days:
              type: "integer"
              default: 30
        test_context:
          type: "object"
          properties:
            company_description:
              type: "string"
            company_type:
              type: "string"
            industry:
              type: "string"
            company_size:
              type: "string"

  unit_test:
    file: "docs/refactor/payloads/phase8_company_research_unit_test.json"
    test_cases:
      - name: "Full research with all fields"
        input:
          company_name: "TechCorp Solutions"
          mission: "Democratize enterprise software"
          values: ["Innovation", "Customer Success", "Transparency"]
          recent_news:
            - title: "Series C Funding"
              date: "2026-01-15"
              summary: "$50M raised"
          culture: "Remote-first, outcome-driven"
          products: ["Cloud Platform", "Analytics Suite"]
          funding_status: "Series C"
          size_range: "500-1000 employees"
          industry: "Enterprise Software"
        expected:
          validation_pass: true
          blob_serialization: true

      - name: "Minimal research"
        input:
          company_name: "SmallCo"
          mission: "Help small businesses"
          values: ["Quality"]
          culture: "Local-focused"
          products: ["Consulting"]
        expected:
          validation_pass: true

      - name: "Missing required field"
        input:
          company_name: "BadCo"
          mission: ""
          values: ["Value1"]
          culture: "Culture"
          products: ["Product1"]
        expected:
          validation_pass: false
          error: "mission is required"

  integration_test:
    file: "docs/refactor/payloads/phase8_company_research_integration.json"
    scenarios:
      - name: "Save and retrieve"
        steps:
          - action: "save_company_research"
            input:
              user_email: "test@example.com"
              company_name: "IntegrationTestCo"
              llm_output: {}
            expected:
              success: true
          - action: "get_company_research"
            input:
              user_email: "test@example.com"
              company_name: "IntegrationTestCo"
            expected:
              success: true
              data_match: true

      - name: "Cache hit prevention"
        steps:
          - action: "save_company_research"
            input:
              user_email: "test@example.com"
              company_name: "CacheTestCo"
            expected:
              cached: false
          - action: "save_company_research"
            input:
              user_email: "test@example.com"
              company_name: "CacheTestCo"
            expected:
              cached: true

      - name: "TTL expiration"
        steps:
          - action: "insert_expired_research"
            ttl_days: -1
          - action: "save_company_research"
            expected:
              cached: false
```

#### Spec 4: `company_research_e2e_spec.yaml`

```yaml
spec_version: "1.0"
date_created: "2026-02-14"
purpose: "E2E test specifications for Company Research"
status: "READY_FOR_IMPLEMENTATION"

e2e_tests:
  - name: "User researches company and retrieves"
    file: "tests/e2e/test_company_research_e2e.py"
    test_id: "E2E-COMP-001"
    steps:
      - action: "POST /v1/company-research/fetch"
        data:
          company_name: "E2ETestCompany"
          job_id: "test-job-001"
        expected:
          status_code: 202
          response:
            research_id: "string"
            status: "processing"
      - action: "GET /v1/company-research/{company_name}"
        poll_max: 10
        poll_interval: 2
        expected:
          status_code: 200
          response:
            company_name: "E2ETestCompany"
            completed: true

  - name: "Cache hit prevents duplicate generation"
    test_id: "E2E-COMP-002"
    steps:
      - action: "POST /v1/company-research/fetch"
        data:
          company_name: "CachedCompany"
        expected:
          response:
            cached: false
      - action: "POST /v1/company-research/fetch"
        data:
          company_name: "CachedCompany"
        expected:
          response:
            cached: true

  - name: "Expired TTL triggers regeneration"
    test_id: "E2E-COMP-003"
    setup:
      - action: "Direct DynamoDB insert"
        ttl_days: -1
    steps:
      - action: "POST /v1/company-research/fetch"
        data:
          company_name: "ExpiredCompany"
        expected:
          response:
            cached: false

  - name: "FVS validation failure rejects content"
    test_id: "E2E-COMP-004"
    mock:
      fvs_validator:
        validate:
          is_valid: false
          violations:
            - "Grammar score below 9.0"
    expected:
      status_code: 422
      response:
        error: "FVS validation failed"
```

